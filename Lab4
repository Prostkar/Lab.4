                if (working)
                {
                    Console.WriteLine("\nНатисніть будь-яку клавішу для повернення в меню...");
                    Console.ReadKey();
                    Console.Clear();
                }
            }
        }

        static void DisplayAndAnalyze(MeteoObservation[] observations)
        {
            Console.WriteLine("\nУсі метеорологічні спостереження:");
            PrintHeader();
            double sumPressure = 0;
            for (int i = 0; i < observations.Length; i++)
            {
                Console.WriteLine(observations[i]);
                sumPressure += observations[i].Pressure;
            }
            PrintFooter();

            double avgPressure = sumPressure / observations.Length;
            Console.WriteLine($"\nСередній атмосферний тиск за весь період: {avgPressure:F2} мм рт. ст.\n");

            Console.WriteLine("Дні з атмосферним тиском, більшим від середнього:");
            PrintHeader();
            int countFound = 0;
            for (int i = 0; i < observations.Length; i++)
            {
                if (observations[i].Pressure > avgPressure)
                {
                    Console.WriteLine(observations[i]);
                    countFound++;
                }
            }
            PrintFooter();

            if (countFound == 0)
            {
                Console.WriteLine("Немає днів з тиском, більшим від середнього.");
            }
        }

        static void EditObservation(MeteoObservation[] observations)
        {
            Console.WriteLine("\nСписок наявних записів для редагування:");
            Console.WriteLine(new string('-', 64));
            Console.WriteLine("| {0,-3} | {1,-12} | {2,-18} | {3,-18} |", "№", "Дата", "Температура (°C)", "Тиск (мм рт. ст.)");
            Console.WriteLine(new string('-', 64));
            for (int i = 0; i < observations.Length; i++)
            {
                Console.WriteLine("| {0,-3} {1}", i + 1, observations[i]);
            }
            Console.WriteLine(new string('-', 64));

            int index = -1;
            // Крок 1: Ввід номера запису в циклі до правильного значення
            while (true)
            {
                try
                {
                    Console.Write($"\nВведіть номер запису для редагування (1..{observations.Length}): ");
                    index = Convert.ToInt32(Console.ReadLine()) - 1;

                    if (index < 0 || index >= observations.Length)
                    {
                        Console.WriteLine($"Помилка: запису з таким номером не існує! Введіть число від 1 до {observations.Length}.");
                        continue;
                    }
                    break;
                }
                catch (FormatException)
                {
                    Console.WriteLine("Помилка: потрібно ввести ціле число! Спробуйте ще раз.");
                }
            }

            // Крок 2: Ввід дати в циклі до правильного значення
            while (true)
            {
                try
                {
                    Console.Write("Введіть нову дату (ДД.ММ.РРРР, наприклад 07.10.2024): ");
                    observations[index].Date = Console.ReadLine();
                    break;
                }
                catch (FormatException e)
                {
                    Console.WriteLine("Помилка вводу дати: " + e.Message);
                }
            }

            // Крок 3: Ввід температури в циклі до правильного значення
            while (true)
            {
                try
                {
                    Console.Write("Введіть нову температуру повітря (°C): ");
                    observations[index].Temperature = Convert.ToDouble(Console.ReadLine());
                    break;
                }
                catch (FormatException e)
                {
                    Console.WriteLine("Помилка вводу температури: " + e.Message + " Введіть число правильно.");
                }
            }

            // Крок 4: Ввід тиску в циклі до правильного значення
            while (true)
            {
                try
                {
                    Console.Write("Введіть новий атмосферний тиск (мм рт. ст.): ");
                    observations[index].Pressure = Convert.ToDouble(Console.ReadLine());
                    break;
                }
                catch (FormatException e)
                {
                    Console.WriteLine("Помилка вводу тиску: " + e.Message + " Введіть число правильно.");
                }
            }

            Console.WriteLine("\nЗапис успішно оновлено!");
        }

        static void PrintHeader()
        {
            Console.WriteLine(new string('-', 58));
            Console.WriteLine("| {0,-12} | {1,-18} | {2,-18} |", "Дата", "Температура (°C)", "Тиск (мм рт. ст.)");
            Console.WriteLine(new string('-', 58));
        }

        static void PrintFooter()
        {
            Console.WriteLine(new string('-', 58));
        }
    }
}

