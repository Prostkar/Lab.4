                new MeteoObservation("02.10.2024", 14.0, 761.0),
                new MeteoObservation("03.10.2024", 12.5, 764.2),
                new MeteoObservation("04.10.2024", 11.8, 765.0),
                new MeteoObservation("05.10.2024", 13.4, 759.8),
                new MeteoObservation("06.10.2024", 16.1, 755.4),
                new MeteoObservation("07.10.2024", 17.0, 754.0),
                new MeteoObservation("08.10.2024", 14.5, 760.5),
                new MeteoObservation("09.10.2024", 10.2, 766.8),
                new MeteoObservation("10.10.2024", 9.8,  768.1)
            };

            bool working = true;
