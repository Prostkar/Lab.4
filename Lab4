namespace Lab4_Task2_Variant11
{
    class NetworkUser
    {
        private string surname;
        private string group;
        private string login;
        private string accountType;

        public NetworkUser()
        {
            Surname = "Невідомо";
            Group = "Без групи";
            Login = "user";
            AccountType = "Гість";
        }

        public NetworkUser(string surname, string group, string login, string accountType)
        {
            this.Surname = surname;
            this.Group = group;
            this.Login = login;
            this.AccountType = accountType;
        }

        public NetworkUser(string fileLine)
        {
            if (string.IsNullOrWhiteSpace(fileLine))
                throw new FormatException("Зчитано порожній рядок з файлу!");

            string[] parts = fileLine.Split(';');
            if (parts.Length != 4)
                throw new FormatException("Невірний формат полів у рядку файлу!");

            this.Surname = parts[0];
            this.Group = parts[1];
            this.Login = parts[2];
            this.AccountType = parts[3];
        }

        public string Surname
        {
            get { return surname; }
            set
            {
                if (string.IsNullOrWhiteSpace(value))
                    throw new FormatException("Прізвище не може бути порожнім!");
                surname = value.Trim();
            }
        }

        public string Group
        {
            get { return group; }
            set
            {
                if (string.IsNullOrWhiteSpace(value))
                    throw new FormatException("Група не може бути порожньою!");
                group = value.Trim();
            }
        }

        public string Login
        {
            get { return login; }
            set
            {
                if (string.IsNullOrWhiteSpace(value) || value.Contains(" "))
                    throw new FormatException("Обліковий запис не може бути порожнім або містити пробіли!");
                login = value.Trim();
            }
        }

        public string AccountType
        {
            get { return accountType; }
            set
            {
                if (string.IsNullOrWhiteSpace(value))
                    throw new FormatException("Тип облікового запису не може бути порожнім!");
                accountType = value.Trim();
            }
        }

        public override string ToString()
        {
            return string.Format("| {0,-18} | {1,-12} | {2,-18} | {3,-22} |", surname, group, login, accountType);
        }

        public string ToFileString()
        {
            return $"{surname};{group};{login};{accountType}";
        }
    }

    class Program
    {
        static string filePath = "network_users.txt";
        static NetworkUser[] users = new NetworkUser[0];

        public static void Run(string[] args)
        {
            Console.OutputEncoding = Encoding.UTF8;
            Console.InputEncoding = Encoding.UTF8;

            try
            {
                if (!File.Exists(filePath))
                {
                    CreateInitialFile();
                }
                LoadFromFile();
            }
            catch (Exception e)
            {
                Console.WriteLine("Критична помилка ініціалізації файлу: " + e.Message);
            }

            bool running = true;
            while (running)
            {
                Console.WriteLine("\n================ ГОЛОВНЕ МЕНЮ ================");
                Console.WriteLine(" 1 - Вивести всі записи з файлу на екран");
                Console.WriteLine(" 2 - Додати новий запис");
                Console.WriteLine(" 3 - Редагувати запис");
                Console.WriteLine(" 4 - Знищити (видалити) запис");
                Console.WriteLine(" 5 - Пошук за прізвищем");
                Console.WriteLine(" 6 - Сортування за типом облікового запису");
                Console.WriteLine(" 7 - Вихід з програми");
                Console.WriteLine("===============================================");
                Console.Write("Оберіть номер пункту меню (1-7): ");

                string input = Console.ReadLine();
                Console.WriteLine();

                switch (input)
                {
                    case "1":
                        LoadFromFile();
                        DisplayAll();
                        break;
                    case "2":
                        AddRecord();
                        break;
                    case "3":
                        EditRecord();
                        break;
                    case "4":
                        DeleteRecord();
                        break;
                    case "5":
                        SearchBySurname();
                        break;
                    case "6":
                        SortByAccountType();
                        break;
                    case "7":
                        Console.WriteLine("Роботу програми завершено.");
                        running = false;
                        break;
                    default:
                        Console.WriteLine("Невірний вибір! Введіть ціле число від 1 до 7.");
                        break;
                }

                if (running)
                {
                    Console.WriteLine("\nНатисніть будь-яку клавішу, щоб продовжити...");
                    Console.ReadKey();
                    Console.Clear();
                }
            }
        }

        static void CreateInitialFile()
        {
            NetworkUser[] initialUsers = new NetworkUser[]
            {
                new NetworkUser("Іваненко", "КН-21", "ivanenko_o", "Користувач"),
                new NetworkUser("Петренко", "ІПЗ-22", "petrenko_m", "Адміністратор"),
                new NetworkUser("Сидоренко", "КН-21", "sydorenko_v", "Користувач"),
                new NetworkUser("Коваленко", "КБ-23", "kovalenko_i", "Модератор"),
                new NetworkUser("Бондаренко", "ІПЗ-22", "bondar_a", "Гість"),
                new NetworkUser("Ткаченко", "КН-21", "tkachenko_s", "Користувач"),
                new NetworkUser("Кравченко", "КБ-23", "kravchenko_d", "Адміністратор"),
                new NetworkUser("Олійник", "КІ-24", "oliinyk_n", "Гість"),
                new NetworkUser("Шевченко", "ІПЗ-22", "shevchenko_t", "Модератор"),
                new NetworkUser("Мельник", "КІ-24", "melnyk_p", "Користувач")
            };

            users = initialUsers;
            SaveToFile();
        }

        static void LoadFromFile()
        {
            try
            {
                StreamReader f = new StreamReader(filePath, Encoding.UTF8);
                NetworkUser[] temp = new NetworkUser[0];
                string line;

                while ((line = f.ReadLine()) != null)
                {
                    if (!string.IsNullOrWhiteSpace(line))
                    {
                        Array.Resize(ref temp, temp.Length + 1);
                        temp[temp.Length - 1] = new NetworkUser(line);
                    }
                }
                f.Close();
                users = temp;
            }
            catch (Exception e)
            {
                Console.WriteLine("Помилка читання файлу: " + e.Message);
            }
        }

        static void SaveToFile()
        {
            try
            {
                StreamWriter f = new StreamWriter(filePath, false, Encoding.UTF8);
                for (int i = 0; i < users.Length; i++)
                {
                    f.WriteLine(users[i].ToFileString());
                }
                f.Close();
            }
            catch (Exception e)
            {
                Console.WriteLine("Помилка збереження у файл: " + e.Message);
            }
        }

        static void DisplayAll()
        {
            if (users.Length == 0)
            {
                Console.WriteLine("База даних порожня.");
                return;
            }

            Console.WriteLine(new string('-', 86));
            Console.WriteLine("| {0,-3} | {1,-18} | {2,-12} | {3,-18} | {4,-22} |",
                "№", "Прізвище", "Група", "Обліковий запис", "Тип облікового запису");
            Console.WriteLine(new string('-', 86));

            for (int i = 0; i < users.Length; i++)
            {
                Console.WriteLine("| {0,-3} {1}", i + 1, users[i]);
            }
            Console.WriteLine(new string('-', 86));
        }

        static void AddRecord()
        {
            // Цикл повторює введення, доки дані не будуть введені правильно
            while (true)
            {
                try
                {
                    Console.Write("Введіть прізвище: ");
                    string surname = Console.ReadLine();

                    Console.Write("Введіть групу: ");
                    string group = Console.ReadLine();

                    Console.Write("Введіть обліковий запис (логін): ");
                    string login = Console.ReadLine();

                    Console.Write("Введіть тип облікового запису: ");
                    string accType = Console.ReadLine();

                    NetworkUser newUser = new NetworkUser(surname, group, login, accType);

                    Array.Resize(ref users, users.Length + 1);
                    users[users.Length - 1] = newUser;

                    SaveToFile();
                    Console.WriteLine("Запис успішно додано та збережено у файл!");
                    break; // Успішно — виходимо з циклу вводу
                }
                catch (FormatException e)
                {
                    Console.WriteLine("Помилка вводу: " + e.Message + " Будь ласка, введіть дані правильно.");
                }
            }
        }

        static void EditRecord()
        {
            DisplayAll();
            if (users.Length == 0) return;

            while (true)
            {
                try
                {
                    Console.Write($"Введіть номер запису для редагування (1..{users.Length}): ");
                    string inputIndex = Console.ReadLine();
                    int index = Convert.ToInt32(inputIndex) - 1;

                    if (index < 0 || index >= users.Length)
                    {
                        Console.WriteLine($"Помилка: запису з таким номером немає. Введіть число від 1 до {users.Length}.");
                        continue;
                    }

                    Console.Write("Нове прізвище: ");
                    string surname = Console.ReadLine();

                    Console.Write("Нова група: ");
                    string group = Console.ReadLine();

                    Console.Write("Новий обліковий запис: ");
                    string login = Console.ReadLine();

                    Console.Write("Новий тип облікового запису: ");
                    string accType = Console.ReadLine();

                    users[index].Surname = surname;
                    users[index].Group = group;
                    users[index].Login = login;
                    users[index].AccountType = accType;

                    SaveToFile();
                    Console.WriteLine("Запис успішно відредаговано!");
                    break;
                }
                catch (FormatException e)
                {
                    Console.WriteLine("Помилка вводу числа або рядка: " + e.Message + " Спробуйте ще раз.");
                }
            }
        }

        static void DeleteRecord()
        {
            DisplayAll();
            if (users.Length == 0) return;

            while (true)
            {
                try
                {
                    Console.Write($"Введіть номер запису для видалення (1..{users.Length}): ");
                    int index = Convert.ToInt32(Console.ReadLine()) - 1;

                    if (index < 0 || index >= users.Length)
                    {
                        Console.WriteLine($"Помилка: такого номера немає. Введіть від 1 до {users.Length}.");
                        continue;
                    }

                    for (int i = index; i < users.Length - 1; i++)
                    {
                        users[i] = users[i + 1];
                    }
                    Array.Resize(ref users, users.Length - 1);

                    SaveToFile();
                    Console.WriteLine("Запис успішно видалено!");
                    break;
                }
                catch (FormatException)
                {
                    Console.WriteLine("Помилка: потрібно ввести ціле число! Спробуйте ще раз.");
                }
            }
        }

        static void SearchBySurname()
        {
            while (true)
            {
                try
                {
                    Console.Write("Введіть прізвище для пошуку: ");
                    string searchSurname = Console.ReadLine();

                    if (string.IsNullOrWhiteSpace(searchSurname))
                    {
                        Console.WriteLine("Пошуковий запит не може бути порожнім. Введіть прізвище ще раз:");
                        continue;
                    }

                    searchSurname = searchSurname.Trim();
                    bool found = false;

                    Console.WriteLine("\nРезультати пошуку:");
                    Console.WriteLine(new string('-', 80));
                    Console.WriteLine("| {0,-18} | {1,-12} | {2,-18} | {3,-22} |",
                        "Прізвище", "Група", "Обліковий запис", "Тип облікового запису");
                    Console.WriteLine(new string('-', 80));

                    for (int i = 0; i < users.Length; i++)
                    {
                        if (string.Compare(users[i].Surname, searchSurname, StringComparison.OrdinalIgnoreCase) == 0)
                        {
                            Console.WriteLine(users[i]);
                            found = true;
                        }
                    }
                    Console.WriteLine(new string('-', 80));

                    if (!found)
                    {
                        Console.WriteLine("Користувача з таким прізвищем не знайдено.");
                    }
                    break;
                }
                catch (Exception e)
                {
                    Console.WriteLine("Помилка: " + e.Message + " Спробуйте ще раз.");
                }
            }
        }

        static void SortByAccountType()
        {
            if (users.Length < 2)
            {
                Console.WriteLine("Недостатньо записів для сортування.");
                return;
            }

            for (int i = 0; i < users.Length - 1; i++)
            {
                for (int j = 0; j < users.Length - i - 1; j++)
                {
                    if (string.Compare(users[j].AccountType, users[j + 1].AccountType, StringComparison.OrdinalIgnoreCase) > 0)
                    {
                        NetworkUser temp = users[j];
                        users[j] = users[j + 1];
                        users[j + 1] = temp;
                    }
                }
            }

            SaveToFile();
            Console.WriteLine("Записи успішно відсортовано за типом облікового запису:");
            DisplayAll();
        }
    }
}
