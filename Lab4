namespace Lab4_Task1_Variant11
{
    class MeteoObservation
    {
        private DateTime date;
        private double temperature;
        private double pressure;

        public MeteoObservation()
        {
            date = new DateTime(2024, 10, 1);
            temperature = 0;
            pressure = 760;
        }

        public MeteoObservation(string dateStr, double temperature, double pressure)
        {
            this.Date = dateStr;
            this.Temperature = temperature;
            this.Pressure = pressure;
        }

        public string Date
        {
            get { return date.ToString("dd.MM.yyyy"); }
            set
            {
                if (string.IsNullOrWhiteSpace(value))
                    throw new FormatException("Дата не може бути порожньою!");

                // Перевірка реальної календарної дати у форматі ДД.ММ.РРРР
                DateTime parsedDate;
                if (!DateTime.TryParseExact(value.Trim(), "dd.MM.yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out parsedDate))
                {
                    throw new FormatException("Неіснуюча дата або невірний формат! Введіть реальну дату у форматі ДД.ММ.РРРР (наприклад, 07.10.2024).");
                }

                date = parsedDate;
            }
        }

        public double Temperature
        {
            get { return temperature; }
            set
            {
                if (value < -90 || value > 60)
                    throw new FormatException("Значення температури повинно бути в межах від -90 до +60 °C!");
                temperature = value;
            }
        }

        public double Pressure
        {
            get { return pressure; }
            set
            {
                if (value < 650 || value > 830)
                    throw new FormatException("Некоректний тиск! Атмосферний тиск має бути в межах 650–830 мм рт. ст.");
                pressure = value;
            }
        }

        public override string ToString()
        {
            return string.Format("| {0,-12} | {1,18:F1} | {2,18:F1} |", Date, temperature, pressure);
        }
    }

    class Program
    {
        public static void Run(string[] args)
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;
            Console.InputEncoding = System.Text.Encoding.UTF8;

            MeteoObservation[] observations = new MeteoObservation[10]
